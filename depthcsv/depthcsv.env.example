# /etc/depthcsv.env — секретов здесь нет (rclone настраивается отдельно, см. README)
SYMBOLS=BTCUSDT,ETHUSDT
OUT_DIR=/var/lib/depthcsv
# часовые файлы по UTC (60 или 30)
ROTATE_MIN=60
# плановый REST-снимок /fapi/v1/depth?limit=1000, сек
SNAPSHOT_SEC=600
# нет aggTrade по этому символу N сек -> GAP + WARN + переподключение (0 = выкл.)
WATCHDOG_SYMBOL=BTCUSDT
TRADE_WATCHDOG_SEC=30
# WS_DEPTH_BASE=wss://fstream.binance.com/public/stream
# WS_TRADE_BASE=wss://fstream.binance.com/market/stream
# REST_BASE=https://fapi.binance.com

# предупреждение в лог (stats рекордера и depthcsv-upload.sh), если свободно меньше, ГБ
MIN_FREE_GB=5
# выгрузка depthcsv-upload.sh выключена, пока RCLONE_REMOTE не задан (и таймер не включён)
# RCLONE_REMOTE=myremote:depthcsv/
# RCLONE_CONFIG=/etc/depthcsv/rclone.conf
