[Unit]
Description=depthcsv: копирование закрытых файлов в rclone-remote (rclone copy, по умолчанию выключена)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=depthcsv
EnvironmentFile=/etc/depthcsv.env
ExecStart=/opt/depthcsv/depthcsv-upload.sh
Nice=10
IOSchedulingClass=idle
